          "id": "readiness-mindset",
          "heading": "Readiness mindset",
          "items": [
            {
              "text": "A plan supports a conversation; it does not guarantee financing.",
              "reviewFlags": [
                "financing"
              ],
              "sourceNeeded": false
            },
            {
              "text": "Ask who the audience is (bank, BDC, grant program, partner) before drafting.",
              "reviewFlags": [
                "financing",
                "program"
              ],
              "sourceNeeded": true
            }
          ]
        },
        {
          "id": "core-sections",
          "heading": "Core sections to prepare",
          "items": [
            {
              "text": "Problem, offer, and customer: clear without hype.",
              "sourceNeeded": false
            },
            {
              "text": "Operations: how work gets done in the first 6–12 months.",
              "sourceNeeded": false
            },
            {
              "text": "Financial story: assumptions listed; no invented revenue guarantees.",
              "reviewFlags": [
                "financing",
                "tax"
              ],
