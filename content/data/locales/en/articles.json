      "sections": [
        {
          "id": "who-this-is-for",
          "heading": "Who this outline is for",
          "items": [
            {
              "text": "Newcomers exploring whether and how to start a business in Alberta.",
              "sourceNeeded": false
            },
            {
              "text": "Owners who need a sequencing checklist—not a guarantee of approval.",
              "sourceNeeded": false
            }
          ]
        },
        {
          "id": "before-you-file",
          "heading": "Questions before you file anything",
          "items": [
            {
              "text": "What problem will the business solve, and for whom?",
              "sourceNeeded": false
            },
            {
              "text": "Which legal structure might fit (sole prop, partnership, corporation)?",
              "reviewFlags": [
                "legal",
                "registration"
              ],
              "sourceNeeded": true
            },
            {
              "text": "Do you need immigration advice about work authorization before operating?",
              "reviewFlags": [
                "immigration",
                "legal"
              ],
              "sourceNeeded": true
            }
          ]
        },
        {
          "id": "name-and-registration",
          "heading": "Name search and registration path",
          "items": [
            {
              "text": "Confirm naming rules and NUANS / Alberta name search requirements with a dated official source.",
              "reviewFlags": [
                "registration",
                "legal"
              ],
              "sourceNeeded": true
            },
            {
              "text": "List documents typically required for registration—verify against current Alberta guidance.",
              "reviewFlags": [
                "registration"
              ],
              "sourceNeeded": true
            },
            {
              "text": "Note municipal business licence triggers separately from provincial registration.",
              "reviewFlags": [
                "registration",
                "program"
              ],
              "sourceNeeded": true
            }
          ]
        },
        {
          "id": "tax-and-numbers",
          "heading": "Tax accounts and numbers (flagged)",
          "items": [
            {
              "text": "When a BN / GST / payroll account may be required—verify CRA thresholds with current CRA pages.",
              "reviewFlags": [
                "tax",
                "payroll"
              ],
              "sourceNeeded": true
            },
            {
              "text": "Do not invent rates, thresholds, or filing deadlines in the final article.",
              "reviewFlags": [
                "tax"
              ],
              "sourceNeeded": true
            }
          ]
        },
        {
          "id": "banking-and-insurance",
          "heading": "Banking, insurance, and risk",
          "items": [
            {
              "text": "What banks typically ask for when opening a business account (checklist questions only).",
              "reviewFlags": [
                "financing"
              ],
              "sourceNeeded": true
            },
            {
              "text": "Insurance topics to discuss with a licensed broker—not product recommendations.",
              "reviewFlags": [
                "legal"
              ],
              "sourceNeeded": true
            }
          ]
        },
        {
          "id": "next-steps",
          "heading": "Next steps with Ge’ez",
          "items": [
            {
              "text": "Use the service finder or Fit Call to clarify which advisory support fits—no outcome promises.",
              "sourceNeeded": false
            }
          ]
        }
      ]
