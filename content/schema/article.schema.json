{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geezconsulting.com/schemas/article.json",
  "title": "Article",
  "description": "Resources article. Outlines are not final expert advice. Production HTML/JSON-LD require approved claims and recordStatus.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "locale",
    "recordStatus",
    "localeStatus",
    "title",
    "excerpt",
    "author",
    "reviewer",
    "datePublished",
    "dateModified",
    "disclaimerCategory",
    "relatedServiceId",
    "cta",
    "citations",
    "sections"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "locale": { "type": "string", "enum": ["en", "am", "ti"] },
    "translationOf": { "type": ["string", "null"] },
    "legacyWpUrl": { "type": ["string", "null"] },
    "recordStatus": {
      "type": "string",
      "enum": ["draft", "pending_review", "approved", "rejected", "remove"]
    },
    "localeStatus": {
      "type": "string",
      "enum": [
        "outline",
        "draft",
        "pending_translation",
        "pending_review",
        "approved",
        "retired"
      ]
    },
    "topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "title": { "$ref": "claim-field.json" },
    "excerpt": { "$ref": "claim-field.json" },
    "author": { "$ref": "#/$defs/personCredit" },
    "reviewer": { "$ref": "#/$defs/personCredit" },
    "datePublished": { "$ref": "claim-field.json" },
    "dateModified": { "$ref": "claim-field.json" },
    "disclaimerCategory": {
      "type": "string",
      "enum": [
        "general",
        "legal",
        "tax",
        "payroll",
        "financing",
        "registration",
        "immigration",
        "credit",
        "program"
      ]
    },
    "relatedServiceId": {
      "type": "string",
      "enum": [
        "start-strong",
        "plan-funding-readiness",
        "books-payroll",
        "grow-with-a-system"
      ]
    },
    "cta": {
      "type": "object",
      "required": ["label", "href"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^/" }
      }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "downloads": {
      "type": "array",
      "items": { "$ref": "#/$defs/download" }
    },
    "showToc": { "type": "boolean" },
    "roadmapAction": {
      "type": "string",
      "enum": ["keep", "update", "merge", "redirect", "retire", "new"]
    },
    "roadmapNotes": { "type": "string" }
  },
  "$defs": {
    "personCredit": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "claim-field.json" },
        "role": { "$ref": "claim-field.json" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["id", "label", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "accessed": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^$" },
        "status": {
          "type": "string",
          "enum": ["planned", "needs_verification", "verified", "outdated"]
        },
        "notes": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "heading", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "heading": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outlineItem" }
        }
      }
    },
    "outlineItem": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "reviewFlags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "legal",
              "tax",
              "payroll",
              "financing",
              "registration",
              "immigration",
              "program",
              "credit"
            ]
          }
        },
        "sourceNeeded": { "type": "boolean" }
      }
    },
    "download": {
      "type": "object",
      "required": ["id", "label", "format", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "href": { "type": ["string", "null"] },
        "format": { "type": "string", "enum": ["pdf", "docx", "xlsx", "csv", "other"] },
        "status": {
          "type": "string",
          "enum": ["planned", "draft", "available", "removed"]
        },
        "accessible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hasTaggedStructure": { "type": "boolean" },
            "textAlternativeHref": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
