{
  "meta": {
    "name": "geez-consulting",
    "version": "1.0.0",
    "wcag": "2.2 AA",
    "notes": "Gold #C9A227 is decorative only on light surfaces (fails AA as text on white). Use gold-ink on light, gold-accent on burgundy."
  },
  "color": {
    "burgundy": "#4C1420",
    "burgundy-strong": "#3A0F18",
    "gold-accent": "#C9A227",
    "gold-ink": "#8A5A0A",
    "charcoal": "#1C1917",
    "ink-muted": "#524A45",
    "surface": "#F7F1E8",
    "surface-raised": "#FFFCFA",
    "surface-sunken": "#EFE6D8",
    "on-brand": "#FFF8F4",
    "border": "#D9CFC2",
    "focus": "#175CD3",
    "status-success": "#067647",
    "status-success-bg": "#ECFDF3",
    "status-warning": "#854D0E",
    "status-warning-bg": "#FEF6E7",
    "status-danger": "#B42318",
    "status-danger-bg": "#FEF3F2",
    "status-info": "#175CD3",
    "status-info-bg": "#EFF8FF"
  },
  "pairs": [
    { "fg": "charcoal", "bg": "surface", "min": 4.5, "usage": "body text on warm page" },
    { "fg": "charcoal", "bg": "surface-raised", "min": 4.5, "usage": "body text on cards" },
    { "fg": "ink-muted", "bg": "surface", "min": 4.5, "usage": "secondary text" },
    { "fg": "ink-muted", "bg": "surface-raised", "min": 4.5, "usage": "secondary text on cards" },
    { "fg": "burgundy", "bg": "surface", "min": 4.5, "usage": "brand text / links on page" },
    { "fg": "burgundy", "bg": "surface-raised", "min": 4.5, "usage": "brand text on cards" },
    { "fg": "on-brand", "bg": "burgundy", "min": 4.5, "usage": "primary button / header text" },
    { "fg": "gold-accent", "bg": "burgundy", "min": 3.0, "usage": "gold accent on burgundy (large/UI only)" },
    { "fg": "gold-ink", "bg": "surface", "min": 4.5, "usage": "gold as small text on light" },
    { "fg": "gold-ink", "bg": "surface-raised", "min": 4.5, "usage": "gold as small text on cards" },
    { "fg": "status-danger", "bg": "surface-raised", "min": 4.5, "usage": "error text" },
    { "fg": "status-danger", "bg": "status-danger-bg", "min": 4.5, "usage": "error banner text" },
    { "fg": "status-success", "bg": "status-success-bg", "min": 4.5, "usage": "success banner text" },
    { "fg": "status-warning", "bg": "status-warning-bg", "min": 4.5, "usage": "warning banner text" },
    { "fg": "status-info", "bg": "status-info-bg", "min": 4.5, "usage": "info banner text" },
    { "fg": "charcoal", "bg": "status-danger-bg", "min": 4.5, "usage": "body in error box" },
    { "fg": "focus", "bg": "surface", "min": 3.0, "usage": "focus ring vs page" },
    { "fg": "on-brand", "bg": "burgundy-strong", "min": 4.5, "usage": "pressed primary button" }
  ],
  "forbiddenPairs": [
    { "fg": "gold-accent", "bg": "surface", "reason": "Fails AA as text (~2.4:1)" },
    { "fg": "gold-accent", "bg": "surface-raised", "reason": "Fails AA as text" },
    { "fg": "on-brand", "bg": "surface", "reason": "Near-white on cream" }
  ],
  "typography": {
    "fontSans": "\"Noto Sans\", \"Noto Sans Ethiopic\", system-ui, sans-serif",
    "weights": [400, 700],
    "scale": {
      "xs": { "min": 0.8125, "max": 0.875, "lh": 1.45 },
      "sm": { "min": 0.875, "max": 0.9375, "lh": 1.5 },
      "md": { "min": 1, "max": 1.125, "lh": 1.6 },
      "lg": { "min": 1.125, "max": 1.375, "lh": 1.45 },
      "xl": { "min": 1.375, "max": 1.75, "lh": 1.3 },
      "display": { "min": 1.75, "max": 2.5, "lh": 1.2 }
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem",
    "8": "4rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "full": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(28, 25, 23, 0.08)",
    "md": "0 8px 24px rgba(76, 20, 32, 0.08)"
  },
  "container": {
    "narrow": "40rem",
    "content": "45rem",
    "wide": "72rem"
  },
  "breakpoint": {
    "sm": "32rem",
    "md": "48rem",
    "lg": "64rem"
  },
  "motion": {
    "duration": "150ms",
    "easing": "ease",
    "reduced": "none"
  },
  "touchMin": "44px",
  "focusWidth": "2px",
  "focusOffset": "2px"
}
